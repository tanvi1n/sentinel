# Copy to .env and fill in locally. Never commit .env or any real key.
# Every value here is a harmless placeholder; with these defaults Sentinel runs
# in mock mode and needs no credentials.

# Qualcomm Cloud AI (LIVE semantic provider). Leave empty until access exists.
# With any of the first three empty, LIVE reports UNAVAILABLE ("not configured")
# and no network call is made.
QUALCOMM_API_KEY=
QUALCOMM_BASE_URL=
QUALCOMM_MODEL=
QUALCOMM_TIMEOUT_SECONDS=8

# Semantic provider mode: mock | replay | live | auto
#   auto = LIVE, then REPLAY, then UNAVAILABLE (never mock)
SENTINEL_SEMANTIC_MODE=mock
SENTINEL_PROMPT_VERSION=v1
SENTINEL_REPLAY_PATH=replay/cache.jsonl
